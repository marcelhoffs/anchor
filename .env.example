# Copy to .env and fill in. docker compose reads .env via env_file.
# The values below are the secure choices; loosen them only when you need to.

# Required. Public URL Anchor is reached at. Use https: it turns on Secure
# cookies and HSTS, and passkeys need a domain name over https.
ANCHOR_BASE_URL=https://anchor.example.com

# Required. 32+ random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Keep it secret and stable: it encrypts authenticator-app secrets.
ANCHOR_SECRET_KEY=

# Everyone must set up two-factor authentication (an authenticator app or a
# passkey) before using Anchor. Set here, it can't be switched off on the
# admin page; remove the line to leave the choice to admins.
ANCHOR_REQUIRE_2FA=true

# Who can sign up: closed (only admins add users; the default), invite or
# open. Left unset so admins can send invites from the admin page; set it to
# pin the choice.
#ANCHOR_SIGNUP=closed

# Optional. Create the first admin on an empty database (password: 10+
# characters). Remove both once the account exists.
#ANCHOR_ADMIN_USER=admin
#ANCHOR_ADMIN_PASSWORD=

# Where page titles, descriptions and icons may be fetched from: public
# (internet addresses only), all (also your own network, for bookmarks of
# self-hosted services; any user can then make Anchor fetch from it) or off.
ANCHOR_FETCH=public

# When a site serves no icon, ask public icon services instead: off,
# duckduckgo, google, or duckduckgo,google. A service learns the bookmarked
# domain (e.g. klm.be), never the full link.
ANCHOR_FAVICON_FALLBACK=off

# Optional. CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Keep it as narrow as you can: anything in it can claim to be any
# client. Behind a proxy on the Docker network, its gateway address, e.g.:
#ANCHOR_TRUSTED_PROXIES=172.18.0.1/32

# Optional. Sign in through an OpenID Connect provider (Authentik, Keycloak,
# Entra ID…); see docs/deployment.md. The provider's redirect URI is
# <ANCHOR_BASE_URL>/login/oidc/callback.
#ANCHOR_OIDC_ISSUER=https://authentik.example.com/application/o/anchor/
#ANCHOR_OIDC_CLIENT_ID=
#ANCHOR_OIDC_CLIENT_SECRET=
#ANCHOR_OIDC_NAME=Authentik
# Members of this group are admins (checked at sign-in and at every page
# load; needs refresh tokens, so allow offline_access at the provider).
#ANCHOR_OIDC_ADMIN_GROUP=
# true: only the provider, no password sign-in or sign-up.
#ANCHOR_OIDC_ONLY=false

# debug, info or warn.
ANCHOR_LOG_LEVEL=info

# Optional. Defaults suit the Docker image; change only if you know why.
#ANCHOR_DATA_DIR=/data
#ANCHOR_LISTEN=:8080
