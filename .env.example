# Copy to .env and fill in. docker compose reads .env via env_file.

# Required. Public URL Burrow is reached at; https turns on Secure cookies.
# Passkeys need a domain name over https (not an IP address).
BURROW_BASE_URL=https://burrow.example.com

# Required. 32+ random bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Keep it stable: it encrypts authenticator-app secrets.
BURROW_SECRET_KEY=

# Optional. Who can sign up (closed, invite or open) and whether everyone must
# use two-factor authentication. Leave unset to manage both on the admin page.
#BURROW_SIGNUP=closed
#BURROW_REQUIRE_2FA=false

# Optional. Create the first admin on an empty database (password: 10+ characters).
# Remove both once the account exists.
#BURROW_ADMIN_USER=admin
#BURROW_ADMIN_PASSWORD=

# Optional. Where page titles, descriptions and icons may be fetched from:
# public (default; internet addresses only), all (also your own network, for
# bookmarks of self-hosted services; any user can then make Burrow fetch from
# it) or off.
#BURROW_FETCH=public

# Optional. When a site serves no icon or blocks Burrow, ask a public icon
# service instead: off (default) or duckduckgo. The service learns the
# bookmarked domain (e.g. klm.be), never the full link.
#BURROW_FAVICON_FALLBACK=off

# Optional. CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
#BURROW_TRUSTED_PROXIES=172.16.0.0/12

# Optional. debug, info or warn.
#BURROW_LOG_LEVEL=info

# Optional. Defaults suit the Docker image; change only if you know why.
#BURROW_DATA_DIR=/data
#BURROW_LISTEN=:8080
